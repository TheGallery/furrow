{
  "name": "furrow",
  "version": "0.1.0",
  "private": true,
  "description": "A calm top-down farming sandbox: drive the machines over one field while you wait.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
